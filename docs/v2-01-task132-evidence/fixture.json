    {
      "id": "Q04",
      "text": "申请模拟退款需要提供什么信息？",
      "expected": "refund-entry"
    },
    {
      "id": "Q05",
      "text": "知识说明可以改变退款资格和金额吗？",
      "expected": "refund-entry"
    },
    {
      "id": "Q06",
      "text": "等待审批时，在聊天中说“同意”可以批准吗？",
      "expected": "approval-wait"
    },
    {
      "id": "Q07",
      "text": "审批通过后恢复原任务还是另建任务？",
      "expected": "approval-wait"
    },
    {
      "id": "Q08",
      "text": "一次审批能放行其他任意调用吗？",
      "expected": "approval-wait"
    },
    {
      "id": "Q09",
      "text": "模拟退款会扣真实银行卡的钱吗？",
      "expected": "refund-safety"
    },
    {
      "id": "Q10",
      "text": "退款结果未知时可以直接再退一次吗？",
      "expected": "refund-safety"
    },
    {
      "id": "Q11",
      "text": "相同退款操作如何避免重复副作用？",
      "expected": "refund-safety"
    },
    {
      "id": "Q12",
      "text": "查询订单需要提供什么？",
      "expected": "order-query"
    },
    {
      "id": "Q13",
      "text": "能查看其他演示用户的订单吗？",
      "expected": "order-query"
    },
    {
      "id": "Q14",
      "text": "关闭聊天页面后，已受理任务会停止吗？",
      "expected": "stream-help"
    },
    {
      "id": "Q15",
      "text": "断开连接后应如何核对任务结果？",
      "expected": "stream-help"
    },
    {
      "id": "Q16",
      "text": "If the stream disconnects, does the accepted task continue?",
      "expected": "stream-help"
    },
    {
      "id": "Q17",
      "text": "Does this demo connect to a real payment provider?",
      "expected": "refund-safety"
    },
    {
      "id": "Q18",
      "text": "Who handles a pending refund approval?",
      "expected": "approval-wait"
    },
    {
      "id": "Q19",
      "text": "dev-user 和 demo-user-b 是生产认证账号吗？",
      "expected": "account-help"
    },
    {
      "id": "Q20",
      "text": "申请退款后，谁审批，审批后如何继续？",
      "expected": "refund-entry,approval-wait"
