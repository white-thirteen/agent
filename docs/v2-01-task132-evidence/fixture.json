      "content_hash": "7b8ced91aa1b6eaef5662c3f8e26b43f7ef5fc001ba3d71210abc59b8ab65e60",
      "content": "审批记录包含操作时间与对应申请的信息，便于回顾本地演示过程。",
      "line_start": 5,
      "line_end": 5
    },
    {
      "document_id": "task132-distractor-11",
      "document_version": "db331e6998e178e4a73d074bf3810afba8b4268eb67ed8a0a39f958ebeb41e9d",
