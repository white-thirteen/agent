  "questions": [
    {
      "id": "Q01",
      "text": "当前提供哪些演示用户？",
      "expected": "account-help"
    },
    {
      "id": "Q02",
      "text": "选择 dev-user 是否等于真实生产登录？",
      "expected": "account-help"
    },
    {
      "id": "Q03",
      "text": "如何发起模拟退款申请？",
      "expected": "refund-entry"
