    {
      "name": "03 Task与退款事实",
      "item": [
        {
          "name": "当前Task 提取关联",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/agent/tasks/current",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_a}}\",\n  \"conversation_id\": \"{{conversation}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const t = j.current_task;",
                  "if (t) { pm.environment.set('task_id', t.task_id); if(t.run_id) pm.environment.set('run_id',t.run_id); if(t.refund) { for(const k of ['application_id','approval_id']) if(t.refund[k]) pm.environment.set(k,t.refund[k]); } }",
                  "if(j.approval_id) {pm.environment.set('approval_id',j.approval_id); pm.environment.set('subject_digest',j.subject_digest);}",
                  "if(j.run_id) pm.environment.set('run_id',j.run_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "本人退款状态",
