          }
        },
        "description": "从返回subject_digest取得原主体摘要；只读，不会决定或恢复。"
      }
    },
    "/admin/approvals/{approval_id}/decision": {
      "post": {
        "tags": [
          "local-demo-approvals"
        ],
        "summary": "提交批准或拒绝决定",
        "operationId": "decision_admin_approvals__approval_id__decision_post",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Approval Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionInput"
              },
              "example": {
                "decision": "APPROVED",
                "subject_digest": "COPY_FROM_ORIGINAL_APPROVAL"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "approval",
                    "resume_required"
                  ],
                  "properties": {
                    "approval": {
                      "$ref": "#/components/schemas/ApprovalView"
                    },
                    "resume_required": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "404": {
            "description": "非回环/production不可用，或审批不存在"
          },
          "409": {
            "description": "主体、绑定、决定、期限或恢复位置冲突"
          },
          "503": {
            "description": "审批或持久资源不可用"
          }
        },
        "description": "decision仅APPROVED/REJECTED，必须带当前审批的原subject_digest。提交决定后需独立调用resume。Actor由服务端固定，不接收reviewer_id或管理Key。"
      }
    },
