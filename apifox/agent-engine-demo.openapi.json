        "description": "仅查询所选用户原conversation下的申请。application_id为实际UUID，拒绝跨用户或跨会话访问。"
      }
    },
    "/agent/runs/{run_id}/events": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "订阅Run当前快照及后续事件",
        "operationId": "run_events_agent_runs__run_id__events_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              },
              "example": {
                "user_id": "dev-user",
                "conversation_id": "demo-c1"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current snapshot and future events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE事件，event与data按空行分隔；不要当作单个JSON响应。"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "403": {
            "description": "演示用户不在服务端允许名单"
          },
          "404": {
            "description": "Run/会话/申请不存在或归属不匹配"
          },
          "409": {
            "description": "执行门禁、请求冲突、审批保护或不支持事件重放"
          },
          "503": {
            "description": "资源不可用或执行容量不足"
          }
        },
        "description": "text/event-stream，不重放历史token；不支持Last-Event-ID。同Run已有订阅时可能409。断开订阅不取消已受理任务。"
      }
    },
    "/admin/approvals": {
      "get": {
        "tags": [
          "local-demo-approvals"
        ],
        "summary": "列出本地审批",
        "operationId": "list_approvals_admin_approvals_get",
        "parameters": [
          {
            "name": "decision",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "PENDING",
                    "APPROVED",
                    "REJECTED",
                    "EXPIRED"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Decision"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalView"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "404": {
            "description": "非回环/production不可用，或审批不存在"
          },
          "409": {
            "description": "主体、绑定、决定、期限或恢复位置冲突"
          },
          "503": {
            "description": "审批或持久资源不可用"
          }
        },
        "description": "仅development/test及回环客户端；decision可选筛选。GET只读，不决定审批、不续期。"
      }
    },
    "/admin/approvals/{approval_id}": {
      "get": {
        "tags": [
