                "conversation_id": "demo-c1"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "403": {
            "description": "演示用户不在服务端允许名单"
          },
          "404": {
            "description": "Run/会话/申请不存在或归属不匹配"
          },
          "409": {
            "description": "执行门禁、请求冲突、审批保护或不支持事件重放"
          },
          "503": {
            "description": "资源不可用或执行容量不足"
