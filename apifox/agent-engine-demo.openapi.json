{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Engine Demo API",
    "version": "0.1.0",
    "description": "当前FastAPI接口契约，2026-11-15导出。订单/退款均为本地模拟；RAG与Memory通过同一chat入口。development/test允许名单内user_id仅作演示身份选择；本地审批无管理员认证，Actor由服务端固定，production不注册审批接口。仅手动导入材料，Apifox导入及客户端脚本/SSE效果待用户验证。"
  },
  "paths": {
    "/agent/chat": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "提交聊天/订单/退款/RAG/记忆任务",
        "operationId": "chat_agent_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "examples": {
                "order": {
                  "summary": "本人订单",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "message": "请查询我的订单",
                    "input_mode": "new_task"
                  }
                },
                "refund": {
                  "summary": "模拟退款（替换为本人未退款订单）",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "message": "请为我的订单 YOUR_ORDER_ID 申请模拟退款",
                    "input_mode": "new_task"
                  }
                },
                "rag": {
                  "summary": "真实知识问答（需先启用并导入语料）",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "message": "银帆演示中普通聊天可以批准模拟退款吗？",
                    "input_mode": "new_task"
                  }
                },
                "memorySave": {
                  "summary": "显式保存偏好",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "message": "请记住：回答语言=英语",
                    "input_mode": "new_task"
                  }
                },
                "memoryRead": {
                  "summary": "另一会话读取相同用户偏好",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c2",
                    "message": "请查看偏好记忆",
                    "input_mode": "new_task"
                  }
                },
                "memoryStyle": {
                  "summary": "请记住：回答风格=简洁",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "input_mode": "new_task",
                    "message": "请记住：回答风格=简洁"
                  }
                },
                "memoryUpdate": {
                  "summary": "请修改记忆：回答风格=详细",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "input_mode": "new_task",
                    "message": "请修改记忆：回答风格=详细"
                  }
                },
                "memoryDelete": {
                  "summary": "请删除记忆：回答风格",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "input_mode": "new_task",
                    "message": "请删除记忆：回答风格"
                  }
                },
                "memoryClear": {
                  "summary": "请删除全部偏好记忆",
                  "value": {
                    "user_id": "dev-user",
                    "conversation_id": "demo-c1",
                    "input_mode": "new_task",
                    "message": "请删除全部偏好记忆"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Agent event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE事件，event与data按空行分隔；不要当作单个JSON响应。"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "403": {
            "description": "演示用户不在服务端允许名单"
          },
          "404": {
            "description": "Run/会话/申请不存在或归属不匹配"
          },
          "409": {
            "description": "执行门禁、请求冲突、审批保护或不支持事件重放"
          },
          "503": {
            "description": "资源不可用或执行容量不足"
          }
        },
        "description": "返回text/event-stream。input_mode=auto用于普通输入或原澄清续接；new_task明确开始新Task，不能绕过执行中/审批等待门禁。refund审批不经此接口。"
      }
    },
    "/agent/runs/{run_id}/status": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "查询本次Run",
        "operationId": "run_status_agent_runs__run_id__status_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              },
              "example": {
                "user_id": "dev-user",
                "conversation_id": "demo-c1"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "403": {
            "description": "演示用户不在服务端允许名单"
          },
          "404": {
            "description": "Run/会话/申请不存在或归属不匹配"
          },
          "409": {
            "description": "执行门禁、请求冲突、审批保护或不支持事件重放"
          },
          "503": {
            "description": "资源不可用或执行容量不足"
          }
        },
        "description": "身份及原conversation必须匹配。Run缓存可淘汰，进程重启后可能404；持久Task和退款事实应分别查询。"
      }
    },
