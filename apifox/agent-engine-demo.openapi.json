            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyInput"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "404": {
            "description": "非回环/production不可用，或审批不存在"
          },
          "409": {
            "description": "主体、绑定、决定、期限或恢复位置冲突"
          },
          "503": {
            "description": "审批或持久资源不可用"
          }
        },
        "description": "仅针对已持久化原interrupt的缺失绑定；请求{}。正常绑定无需调用，未知关联不盲修。"
      }
    },
    "/admin/approvals/{approval_id}/resume": {
      "post": {
        "tags": [
          "local-demo-approvals"
        ],
        "summary": "恢复原审批关联任务",
        "operationId": "resume_admin_approvals__approval_id__resume_post",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Approval Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/EmptyInput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeAcceptance"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "404": {
            "description": "非回环/production不可用，或审批不存在"
          },
          "409": {
            "description": "主体、绑定、决定、期限或恢复位置冲突"
          },
          "503": {
            "description": "审批或持久资源不可用"
          },
          "202": {
            "description": "已受理原Task的新一次Run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeAcceptance"
                }
              }
            }
          }
        },
        "description": "请求{}或省略body。首次受理202，新Run/原Task；已结束只读200 accepted=false/run_id=null。未知快照/执行状态409，不盲重放、不创建新operation。"
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "健康检查",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        },
        "description": "返回安全就绪状态；HTTP存活不代表Chat网络或知识库已经可用。"
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "title": "User Id"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "title": "Conversation Id"
          },
          "message": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message"
          },
          "input_mode": {
            "type": "string",
            "enum": [
              "auto",
              "new_task"
            ],
            "title": "Input Mode",
            "default": "auto"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
