# Copy to .env. Startup and /health do not require model or database credentials.
AGENT_APP_NAME="Agent Backend"
AGENT_APP_ENV=development
AGENT_DEBUG=false
AGENT_LOG_LEVEL=INFO

# Reserved for the next development stages; not consumed by the runtime yet.
# AGENT_MODEL_NAME=your-model-name
# AGENT_MODEL_BASE_URL=https://your-provider.example/v1
# AGENT_MODEL_API_KEY=replace-with-your-key
# AGENT_DATABASE_URL=postgresql://agent:password@localhost:5432/agent
