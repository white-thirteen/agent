# Copy to .env only if it does not exist. Keep secrets local.
AGENT_APP_NAME="Agent Engine Demo"
AGENT_APP_ENV=development
AGENT_DEBUG=false
AGENT_LOG_LEVEL=INFO
AGENT_DEMO_USER_IDS='["dev-user", "demo-user-b"]'

# Consumed at startup. Initialization does not verify provider connectivity.
# AGENT_MODEL_NAME=your-model-name
# AGENT_MODEL_BASE_URL=https://your-provider.example/v1
# AGENT_MODEL_API_KEY=replace-locally
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_MODEL_MAX_ATTEMPTS=8
AGENT_MODEL_MAX_RETRIES=1

# Task cumulative budgets. Runtime enforcement in 02, tool counting in 03.
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_RUN_MAX_TOOL_CALLS=12

# Application owners. Explicit initialization and migrations are required.
# AGENT_DATABASE_URL=postgresql://agent_app:replace-locally@127.0.0.1:5432/agent_demo
# AGENT_TEST_DATABASE_URL=postgresql://agent_test:replace-locally@127.0.0.1:5432/agent_demo_test
AGENT_DATABASE_POOL_MIN_SIZE=1
AGENT_DATABASE_POOL_MAX_SIZE=5
AGENT_DATABASE_CONNECT_TIMEOUT_SECONDS=5
AGENT_DATABASE_STARTUP_TIMEOUT_SECONDS=10

# Compose/bootstrap only. Web Settings does not consume these admin values.
# POSTGRES_USER=agent_bootstrap
# POSTGRES_PASSWORD=replace-locally
# POSTGRES_PORT=5432
# AGENT_DATABASE_ADMIN_URL=postgresql://agent_bootstrap:replace-locally@127.0.0.1:5432/postgres
